APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./content_diagnosis.db
REDIS_URL=redis://localhost:6379/0
ANALYSIS_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
STORAGE_PATH=./data
PLAYWRIGHT_HEADLESS=true
MAX_PAGES_PER_SOURCE=20
REQUEST_DELAY_MS=750
COMPARABILITY_MIN_PAGES=3

# Async jobs: inline (dev) or celery (production, uses REDIS_URL)
JOB_BACKEND=inline

# Storage: local (dev) or s3 (S3-compatible, production)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PREFIX=

# When set, the API requires Authorization: Bearer <token>. Leave blank for open dev.
API_AUTH_TOKEN=
